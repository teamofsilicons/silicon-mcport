# Store the completed file outside source control with mode 0600.
# Silicon Accounts: the public URL issues access tokens (it is their `iss`).
ACCOUNTS_URL=https://accounts.teamofsilicons.com
# Optional: where MCPort calls Silicon Accounts, when that differs from ACCOUNTS_URL.
# ACCOUNTS_API_URL=
MCPORT_APP_ID=mcport
# The mcport app's secret from Silicon Accounts (server only; never in the website).
MCPORT_APP_SECRET=
# The whsec_ secret of mcport's webhook (https://api.mcport.teamofsilicons.com/webhooks/accounts).
MCPORT_ACCOUNTS_WEBHOOK_SECRET=
MCPORT_BIND=127.0.0.1:4380
MCPORT_PUBLIC_URL=https://your-mcport-host.example
MCPORT_WEB_URL=https://your-mcport-website.example
MCPORT_DATA_DIR=/var/lib/mcport
MCPORT_TELEMETRY_KEY=
POSTMARK_SERVER_TOKEN=
MCPORT_REPORT_FROM=mcport@teamofsilicons.com
