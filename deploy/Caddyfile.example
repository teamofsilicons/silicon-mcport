# Replace with the selected public origin after DNS and infrastructure are ready.
mcport.example.com {
	encode zstd gzip
	# The backend serves the built website and API. Caddy preserves cookies and
	# forwards request headers, including IAM testing headers, by default.
	reverse_proxy 127.0.0.1:4380
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
